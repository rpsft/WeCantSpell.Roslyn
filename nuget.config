<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="nuget.org" value="https://nuget.rapidsoft.ru/nuget/Rapidsoft-NugetORG/v3/index.json" />
    <add key="nuget.rapidsoft.ru" value="https://nuget.rapidsoft.ru/nuget/Rapidsoft-Nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.rapidsoft.ru">
      <package pattern="RapidSoft.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
