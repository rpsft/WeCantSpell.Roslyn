<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2024.3.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
    <!-- Pin transitive MSBuild task assembly to a patched version (CVE-2025-26646). MSBuild is
         supplied at runtime by the SDK via MSBuildLocator, so exclude runtime assets to avoid
         shadowing the loader-resolved assemblies. -->
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.14.28" ExcludeAssets="runtime" />
    <!-- Pin transitive crypto assembly pulled by the MSBuild task chain to a patched version
         (CVE-2026-33116 / CVE-2026-26171). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeCantSpell.Roslyn\WeCantSpell.Roslyn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Integration\CSharp\Parsing\Files\*.csx" />
    <EmbeddedResource Include="SpellChecker\Files\*.dic" />
    <EmbeddedResource Include="SpellChecker\Files\*.csx" />
    <Content Include="SpellChecker\Files\*.dic" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SpellChecker\TestDirectory\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
